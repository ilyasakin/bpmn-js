{
  "name": "bpmn-xyflow",
  "version": "0.1.0",
  "description": "BPMN 2.0 viewer and modeler for the web, built on @xyflow/system. Fork of bpmn-js.",
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "lib",
    "!lib/**/*.spec.ts",
    "!lib/demo"
  ],
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "start": "node lib/demo/serve.mjs",
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm run test:smoke && pnpm run test:react && pnpm run test:multi",
    "test:smoke": "node lib/demo/modeler/smoke-test.mjs",
    "test:react": "node lib/demo/react/smoke-test.mjs",
    "test:multi": "node lib/demo/multi-framework-smoke-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bpmn-xyflow"
  },
  "keywords": [
    "bpmn",
    "bpmn-xyflow",
    "xyflow",
    "react-flow",
    "modeler",
    "modeling",
    "process modeling"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@xyflow/system": "^0.0.76",
    "bpmn-moddle": "^10.0.0",
    "diagram-js": "^15.14.0",
    "ids": "^3.0.2",
    "inherits-browser": "^0.1.0",
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0",
    "tiny-svg": "^4.1.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "bpmn-font": "^0.12.1",
    "oxfmt": "*",
    "oxlint": "^1.0.0",
    "puppeteer": "^24.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.55.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.34"
  }
}
