{
  "name": "bpmn-js",
  "version": "19.0.0",
  "description": "A bpmn 2.0 toolkit and web modeler (xyflow-based)",
  "main": "lib/index.js",
  "files": [
    "lib",
    "!lib/**/*.spec.ts",
    "!lib/demo"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "run-s format:markdown 'lint -- --fix'",
    "format:markdown": "remark . -qo",
    "start": "node lib/demo/serve.mjs",
    "test": "run-s test:smoke test:react test:multi",
    "test:smoke": "node lib/demo/modeler/smoke-test.mjs",
    "test:react": "node lib/demo/react/smoke-test.mjs",
    "test:multi": "node lib/demo/multi-framework-smoke-test.mjs"
  },
  "engines": {
    "node": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/bpmn-js"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "toolkit",
    "web modeler",
    "modeler",
    "modeling",
    "process modeling",
    "xyflow"
  ],
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.1.1",
    "bpmn-font": "^0.12.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-bpmn-io": "^2.2.0",
    "npm-run-all2": "^8.0.4",
    "puppeteer": "^24.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-cli": "^12.0.1",
    "remark-preset-bpmn-io": "^0.4.0",
    "svelte": "^4.2.20",
    "svelte-loader": "^3.2.4",
    "typescript": "^5.9.3",
    "vue": "^3.5.34",
    "webpack": "^5.106.2"
  },
  "dependencies": {
    "@xyflow/system": "^0.0.76",
    "bpmn-moddle": "^10.0.0",
    "diagram-js": "^15.14.0",
    "ids": "^3.0.2",
    "inherits-browser": "^0.1.0",
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0",
    "tiny-svg": "^4.1.4"
  },
  "remarkConfig": {
    "plugins": [
      "preset-bpmn-io",
      [
        "lint-no-html",
        false
      ]
    ]
  }
}
